# Preserve existing CRLF artifacts without treating the carriage return as
# trailing whitespace. No files in this repository use Git LFS.
* whitespace=cr-at-eol

# Binary model and figure artifacts should never undergo line-ending conversion.
*.pth binary
*.pt  binary
*.pkl binary
*.npz binary
*.png binary
*.pdf binary
*.gz  binary

# Matplotlib SVG paths and unmodified journal-vendor files intentionally retain
# upstream trailing spaces; do not flag those generated/vendor bytes as source
# whitespace errors.
paper/figures/*.svg whitespace=-blank-at-eol
paper/template/* whitespace=-blank-at-eol
